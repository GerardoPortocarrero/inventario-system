{
  "rules": {
    "user_roles": {
      ".read": "root.child('user_roles').child(auth.uid).val() === 'admin'",
      ".write": "root.child('user_roles').child(auth.uid).val() === 'admin'",
      "$uid": {
        ".read": "$uid === auth.uid"
      }
    },
    "maestro": {
      ".read": "root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'supervisor'",
      ".write": "root.child('user_roles').child(auth.uid).val() === 'admin'",
      "metadata": {
        ".validate": "newData.hasChildren(['updatedAt', 'rowCount', 'userName'])"
      }
    },
    "demanda": {
      ".read": "root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'supervisor'",
      ".write": "root.child('user_roles').child(auth.uid).val() === 'admin'",
      "metadata": {
        ".validate": "newData.hasChildren(['updatedAt', 'rowCount', 'userName'])"
      }
    },
    "reportes": {
      ".read": "root.child('user_roles').child(auth.uid).val() === 'admin' || root.child('user_roles').child(auth.uid).val() === 'supervisor'",
      ".write": "root.child('user_roles').child(auth.uid).val() === 'admin'",
      "$reporte_name": {
        "metadata": {
          ".validate": "newData.hasChildren(['lastUpdated', 'processedBy'])"
        }
      }
    }
  }
}
